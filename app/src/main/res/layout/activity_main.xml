<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_screen_one">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_badge_screen_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_one_badge"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#60A5FA"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_button_secondary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_title_screen_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_one_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_subtitle_screen_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_one_subtitle"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="40dp" />

        <!-- Botão 1: Google -->
        <Button
            android:id="@+id/btn_google"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:maxWidth="440dp"
            android:text="@string/btn_google_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_google"
            android:stateListAnimator="@null"
            android:elevation="4dp"
            android:layout_marginBottom="18dp" />

        <!-- Botão 2: YouTube -->
        <Button
            android:id="@+id/btn_youtube"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:maxWidth="440dp"
            android:text="@string/btn_youtube_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_youtube"
            android:stateListAnimator="@null"
            android:elevation="4dp"
            android:layout_marginBottom="28dp" />

        <!-- Opção para Segunda Tela -->
        <Button
            android:id="@+id/btn_to_second_screen"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:maxWidth="440dp"
            android:text="@string/nav_to_screen_two"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#60A5FA"
            android:background="@drawable/bg_button_secondary"
            android:stateListAnimator="@null" />

    </LinearLayout>
</ScrollView>
